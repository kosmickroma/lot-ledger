# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Data — never commit DCAD files
data/
assets/
ingest/
*.db
*.sqlite

# Docs — internal notes, not for repo (CODE_GUIDE.md, propelio/, OPERATIONS_RUNBOOK.md are exceptions)
docs/*
!docs/CODE_GUIDE.md
!docs/propelio/
!docs/propelio/**
!docs/OPERATIONS_RUNBOOK.md

# Render / deployment artifacts
.render/

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Text files — passwords, notes, scratch files
*.txt
!requirements.txt

# Build script checkpoint — local resume state, not for repo
.build_checkpoint.json

# Subagent-driven-development scratch state (progress ledger, task briefs)
.superpowers/

# PMTiles build artifacts — large binary files, never commit
*.pmtiles
*.mbtiles

# GeoJSON exports — can be multi-GB, regenerated from DB
*.geojson
*.geojsonl
!frontend/*.geojson

# GCP credentials — never commit
*.json
!package.json
!tsconfig.json
service-account*.json
gcp-key*.json
cors.json
# School-ratings pilot test fixtures (small synthetic zone/rating JSON, no
# credentials, no real DISD data) — 2026-07-20. The REAL baked data lives in
# data/school_pilot/ (excluded via the data/ rule above) and is never
# committed; these are hand-authored test-only fixtures the *.json rule
# above would otherwise silently drop.
!tests/fixtures/school_pilot/*.json
# School-zones DB-build test fixtures (small synthetic geojson/kml/json/md,
# no credentials, no real district data) — 2026-07-21. The *.geojson rule
# above and the *.json rule above would otherwise silently drop these too
# (caught via `git add --dry-run` before committing, same class of gap as
# the school_pilot rule above).
!tests/fixtures/school_zones/**/*.json
!tests/fixtures/school_zones/**/*.geojson
!tests/fixtures/school_zones/**/*.kml
!tests/fixtures/school_zones/**/*.md
