# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Data — never commit DCAD files
data/
assets/
ingest/
*.db
*.sqlite

# Docs — internal notes, not for repo (CODE_GUIDE.md is the exception)
docs/*
!docs/CODE_GUIDE.md

# Render / deployment artifacts
.render/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Text files — passwords, notes, scratch files
*.txt
!requirements.txt

# Build script checkpoint — local resume state, not for repo
.build_checkpoint.json

# PMTiles build artifacts — large binary files, never commit
*.pmtiles
*.mbtiles

# GeoJSON exports — can be multi-GB, regenerated from DB
*.geojson
*.geojsonl
!frontend/*.geojson

# GCP credentials — never commit
*.json
!package.json
!tsconfig.json
service-account*.json
gcp-key*.json
cors.json
